# ===== BANCO DO SERVIDOR (onde o painel lê a view public.vw_visitas) =====
# Preencha no arquivo .env (local) ou nas variáveis de ambiente da Vercel. NUNCA coloque valores reais aqui.
REMOTE_DB_USER=painel_leitura
REMOTE_DB_PASS=
REMOTE_DB_HOST=
REMOTE_DB_PORT=
REMOTE_DB_NAME=painel_ateg
# Opcionais (os padrões já servem):
# CACHE_SEGUNDOS=300          # tempo do cache das respostas
# MAPA_PROPRIEDADES=1         # pino por propriedade (desligado na Vercel por privacidade)
# CONFERENCIA=0               # aba Conferência (desligada na Vercel)
# Não defina TABLE_NAME: o painel usa public.mv_visitas (se existir) ou public.vw_visitas.
